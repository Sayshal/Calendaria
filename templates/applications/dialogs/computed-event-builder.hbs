<section class="cb-content standard-form">
  <p class="hint">{{helpText}}</p>

  <fieldset>
    <legend>{{localize "CALENDARIA.Note.ComputedChain"}}</legend>

    {{#each chain}}
      <fieldset class="cb-condition">
        <legend class="cb-condition-legend">
          {{localize "CALENDARIA.Note.ComputedStep" num=num}}
          <a class="cb-remove" data-action="removeStep" data-index="{{index}}" data-tooltip
            aria-label="{{localize 'CALENDARIA.Note.ComputedRemoveStep'}}">
            <i class="fas fa-times"></i>
          </a>
        </legend>
        <div class="cb-condition-row">
          <select name="chain.{{index}}.type" class="cb-field-select" data-tooltip
            aria-label="{{localize 'CALENDARIA.Note.ComputedStepType'}}">
            {{#each ../stepTypes}}
              <option value="{{value}}" {{#if (eq value ../type)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>

          {{#if isAnchor}}
            <select name="chain.{{index}}.value" class="cb-value-select" data-tooltip
              aria-label="{{localize 'CALENDARIA.Note.ComputedAnchor'}}">
              {{#each ../anchorTypes}}
                <option value="{{value}}" {{#if (eq value ../value)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            {{#if isDateAnchor}}
              <select name="chain.{{index}}.anchorMonth" class="cb-value-select" data-tooltip
                aria-label="{{localize 'ATLAS.Common.Month'}}">
                {{#each ../months}}
                  <option value="{{index}}" {{#if (eq index ../dateAnchorMonth)}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
              <span class="cb-labeled-input">
                <span class="cb-inline-label">{{localize "ATLAS.Common.Day"}}</span>
                <input type="number" name="chain.{{index}}.anchorDay" value="{{dateAnchorDay}}" min="1" class="cb-value-input">
              </span>
            {{/if}}
          {{/if}}

          {{#if isFirstAfter}}
            <select name="chain.{{index}}.condition" class="cb-value-select" data-tooltip
              aria-label="{{localize 'ATLAS.Common.Condition'}}">
              {{#each ../conditionTypes}}
                <option value="{{value}}" {{#if (eq value ../condition)}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            {{#if isMoonPhase}}
              <select name="chain.{{index}}.params.moon" class="cb-value-select" data-tooltip
                aria-label="{{localize 'CALENDARIA.Common.Moon'}}">
                {{#each ../moons}}
                  <option value="{{index}}" {{#if (eq index ../params.moon)}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
              <select name="chain.{{index}}.params.phase" class="cb-value-select" data-tooltip
                aria-label="{{localize 'CALENDARIA.Common.Phase'}}">
                {{#each ../moonPhases}}
                  <option value="{{value}}" {{#if (eq value ../params.phase)}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            {{/if}}
            {{#if isWeekdayCondition}}
              <select name="chain.{{index}}.params.weekday" class="cb-value-select" data-tooltip
                aria-label="{{localize 'CALENDARIA.Common.Weekday'}}">
                {{#each ../weekdays}}
                  <option value="{{index}}" {{#if (eq index ../params.weekday)}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            {{/if}}
            <label class="cb-labeled-input">
              <input type="checkbox" name="chain.{{index}}.params.inclusive" {{#if params.inclusive}}checked{{/if}}>
              <span class="cb-inline-label">{{localize "CALENDARIA.Note.ComputedInclusive"}}</span>
            </label>
          {{/if}}

          {{#if isDaysAfter}}
            <span class="cb-labeled-input">
              <span class="cb-inline-label">{{localize "ATLAS.Common.Days"}}</span>
              <input type="number" name="chain.{{index}}.params.days" value="{{params.days}}" class="cb-value-input"
                data-tooltip aria-label="{{localize 'CALENDARIA.Note.ComputedDaysHint'}}">
            </span>
          {{/if}}

          {{#if isWeekdayOnOrAfter}}
            <select name="chain.{{index}}.params.weekday" class="cb-value-select" data-tooltip
              aria-label="{{localize 'CALENDARIA.Common.Weekday'}}">
              {{#each ../weekdays}}
                <option value="{{index}}" {{#if (eq index ../params.weekday)}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          {{/if}}
        </div>
      </fieldset>
    {{/each}}

    <div class="cb-group-actions">
      <button type="button" class="cb-add-btn" data-action="addStep">
        <i class="fas fa-plus"></i> {{localize "CALENDARIA.Note.ComputedAddStep"}}
      </button>
    </div>
  </fieldset>

  {{#if preview.length}}
    <fieldset>
      <legend>{{localize "CALENDARIA.Note.ComputedPreview"}}</legend>
      {{#each preview}}
        <div class="cb-condition-row">
          <span class="cb-inline-label">{{year}}:</span>
          {{#if failed}}<em>{{label}}</em>{{else}}<span>{{label}}</span>{{/if}}
        </div>
      {{/each}}
    </fieldset>
  {{/if}}

  <fieldset>
    <legend>{{localize "CALENDARIA.Note.ComputedOverrides"}}</legend>
    <p class="hint">{{localize "CALENDARIA.Note.ComputedOverridesHint"}}</p>

    {{#each overrides}}
      <div class="cb-condition-row">
        <span class="cb-labeled-input">
          <span class="cb-inline-label">{{localize "ATLAS.Common.Year"}}</span>
          <input type="number" name="override.{{year}}.year" value="{{year}}" step="1" class="cb-value-input">
        </span>
        <select name="override.{{year}}.month" class="cb-value-select" data-tooltip
          aria-label="{{localize 'ATLAS.Common.Month'}}">
          {{#each ../months}}
            <option value="{{index}}" {{#if (eq index ../month)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
        <span class="cb-labeled-input">
          <span class="cb-inline-label">{{localize "ATLAS.Common.Day"}}</span>
          <input type="number" name="override.{{year}}.day" value="{{day}}" min="1" max="31" class="cb-value-input">
        </span>
        <a class="cb-remove" data-action="removeOverride" data-year="{{year}}" data-tooltip
          aria-label="{{localize 'ATLAS.Common.Delete'}}">
          <i class="fas fa-times"></i>
        </a>
      </div>
    {{/each}}

    <div class="cb-group-actions">
      <button type="button" class="cb-add-btn" data-action="addOverride">
        <i class="fas fa-plus"></i> {{localize "ATLAS.Common.AddOverride"}}
      </button>
    </div>
  </fieldset>
</section>
